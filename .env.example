# Telegram Bot token issued by @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional: restrict the bot to these numeric Telegram user ids (comma separated).
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Maximum size (in pixels) of the long edge of the generated collage
MAX_OUTPUT_EDGE=3000

# Default background colour used when tiles do not fill the canvas (hex, no '#')
CANVAS_BACKGROUND=FFFFFF
